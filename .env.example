# =====================================================================
# Server Configuration
# =====================================================================
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Voice Configuration (Edge-TTS high quality neural voices, $0 cost)
DEFAULT_VOICE=en-US-JennyNeural

# =====================================================================
# 100% FREE & LOW-BUDGET OPEN-SOURCE LLM PROVIDERS
# =====================================================================

# Option A: Local Open-Source via Ollama ($0.00, 100% offline & private)
# Install Ollama from https://ollama.com and run: ollama run llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Option B: Blazing-Fast Open-Source Cloud via Groq ($0.00 Free Tier)
# Get a free key at https://console.groq.com (no credit card needed).
# Runs open-source Llama-3.3-70B & Llama-3.1-8B at 500+ tokens/sec!
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# =====================================================================
# OPTIONAL COMMERCIAL CLOUD PROVIDERS (Free Tier / Low-Cost)
# =====================================================================
# Google Gemini 1.5 Flash (Free tier includes 15 req/min, 1,500/day)
GEMINI_API_KEY=

# OpenAI (gpt-4o-mini, pay-as-you-go)
OPENAI_API_KEY=

# Priority: 'auto' automatically selects Groq -> Ollama -> Gemini -> OpenAI -> Built-in
DEFAULT_LLM_PROVIDER=auto
